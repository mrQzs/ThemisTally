{
  "description": "合同端交差（七端改造第 1 条，第 99 轮）：交给协调人的信、report.md 与 state.md 的全文，以及合同 Markdown 全文。只用内核校验器支持的子集：type、properties、required、additionalProperties: false、enum、const、items、minLength、maxLength、pattern（只写 ASCII）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["letter", "report", "state", "contract_md"],
  "properties": {
    "letter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "in_reply_to", "摘要", "提交", "验证", "偏离", "需协调人决定", "证据"],
      "properties": {
        "type": {"type": "string", "enum": ["交付", "返工完成", "提问", "阻塞", "交接", "进度"]},
        "in_reply_to": {"type": "string", "minLength": 1, "description": "回复的 msg-id"},
        "摘要": {"type": "string", "minLength": 1},
        "提交": {"type": "string", "minLength": 1, "description": "没有就写“无”"},
        "验证": {"type": "string", "minLength": 1, "description": "没有就写“无”"},
        "偏离": {"type": "string", "minLength": 1, "description": "没有就写“无”"},
        "需协调人决定": {"type": "string", "minLength": 1, "description": "没有就写“无”"},
        "证据": {"type": "string", "minLength": 1, "description": "没有就写“无”"}
      }
    },
    "report": {"type": "string", "minLength": 1, "description": "report.md 全文"},
    "state": {"type": "string", "description": "state.md 全文"},
    "contract_md": {"type": "string", "minLength": 1, "description": "合同 Markdown 全文，第一行是“# TASK: <合同任务名>”"}
  }
}
