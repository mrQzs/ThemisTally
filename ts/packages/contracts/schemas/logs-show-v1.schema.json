{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://themis-tally.invalid/schemas/logs-show-v1.schema.json",
  "title": "logs show --json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "attempt",
    "state",
    "state_at",
    "summary",
    "evidence",
    "skipped_links"
  ],
  "properties": {
    "task": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "attempt": {
      "type": "string",
      "pattern": "^attempt-\\p{Nd}{3,}$"
    },
    "state": {
      "type": "string"
    },
    "state_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bytes",
            "truncated",
            "text"
          ],
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            },
            "text": {
              "type": "string"
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "skipped_links": {
      "type": "integer",
      "minimum": 0
    }
  }
}
