{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://themis-tally.invalid/schemas/logs-list-v1.schema.json",
  "title": "logs list --json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempts",
    "skipped_links"
  ],
  "properties": {
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "attempt",
          "state",
          "state_at",
          "evidence_files",
          "evidence_bytes",
          "has_summary"
        ],
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "attempt": {
            "type": "string",
            "pattern": "^attempt-\\p{Nd}{3,}$"
          },
          "state": {
            "type": "string"
          },
          "state_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_files": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "has_summary": {
            "type": "boolean"
          }
        }
      }
    },
    "skipped_links": {
      "type": "integer",
      "minimum": 0
    }
  }
}
