    {
      "name": "U03 内容没变也写",
      "file": "scripts/kit_config.py",
      "old": "        if self.before is not None and data == self.before:\n            return False\n",
      "new": ""
    },
    {
      "name": "U04 审计末尾不补换行",
      "file": "scripts/kit_config.py",
      "old": "prefix = b\"\" if handle.read(1) == b\"\\n\" else b\"\\n\"",
      "new": "prefix = b\"\""
    },
    {
      "name": "U05 有 attempt 在运行也不要 --yes",
      "file": "scripts/kit_config.py",
      "old": "    if not confirm:\n        if in_flight:",
      "new": "    if False:\n        if in_flight:"
