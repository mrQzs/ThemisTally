{
  "command": [
    "node",
    "node_modules/vitest/vitest.mjs",
    "run",
    "packages/contracts/test/config-write.contract.test.ts",
    "packages/contracts/test/locks.contract.test.ts"
  ],
  "cwd": "ts",
  "timeout_seconds": 1200,
  "mutations": [
    {
      "name": "U01 令牌对不上也写",
      "file": "scripts/kit_config.py",
