    {
      "name": "U06 删光子键后留下空对象",
      "file": "scripts/kit_config.py",
      "old": "            if not section:\n                del config[parts[0]]\n",
      "new": ""
    },
    {
      "name": "U07 被占用的报错不写持有者",
      "file": "scripts/kit_config.py",
      "old": "                    raise ConfigError(self._busy_message())",
      "new": "                    raise ConfigError(\"配置锁被占用：%s\" % self.path)"
    }
  ]
}
