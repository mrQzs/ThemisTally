   "old": "{ stdin, stdout, stderr }, CREATE_BREAKAWAY_FROM_JOB);",
   "new": "{ stdin, stdout, stderr }, CREATE_BREAKAWAY_FROM_JOB | 0x200);"
  },
  {
   "name": "J03 context.executable 换成 process.execPath",
   "file": "ts/packages/hub/src/cli.ts",
