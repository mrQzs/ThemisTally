   "new": "setKernelPython(process.execPath);"
  },
  {
   "name": "J04 不设 context.kit_hub",
   "file": "ts/packages/hub/src/cli.ts",
   "old": "  setKitHub(context.kit_hub);\n",
   "new": ""
  },
  {
   "name": "J05 runHub 不用启动器的 context",
   "file": "ts/packages/hub/src/cli.ts",
   "old": "  useLauncherContext(context);\n  try {",
   "new": "  try {"
  },
  {
   "name": "J06 setKitHub 不生效",
   "file": "ts/packages/hub/src/runner.ts",
   "old": "  kitHubPath = path;",
   "new": "  void path;"
  },
