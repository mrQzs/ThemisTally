   "old": "[kernelPython(), kitHubPath, \"--repo\", hub.repo]",
   "new": "[kernelPython(), join(SCRIPTS_DIR, \"kit_hub.py\"), \"--repo\", hub.repo]"
  },
  {
   "name": "J08 整数样的 float 解码成 int",
   "file": "ts/packages/cli/src/main.ts",
   "old": "  if (Array.isArray(value)) return value.map(plain);\n  return value;",
   "new": "  if (Array.isArray(value)) return value.map(plain);\n  return typeof value === \"number\" && Number.isInteger(value) ? BigInt(value) : value;"
  },
  {
   "name": "J09 HubError 不写 ERROR:",
   "file": "ts/packages/hub/src/cli.ts",
   "old": "out.printErr(`ERROR: ${error.message}`);",
   "new": "out.printErr(error.message);"
