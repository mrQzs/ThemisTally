      "file": "ts/packages/hub/src/prompt.ts",
      "old": "text = text.split(`{{${key}}}`).join(value);",
      "new": "text = text.replace(`{{${key}}}`, value);"
    },
    {
      "name": "D03 模板只重读一次",
      "file": "ts/packages/hub/src/prompt.ts",
      "old": "attempt < TEMPLATE_READ_TRIES",
