    },
    {
      "name": "D04 工程要求读工作区里没提交的 AGENTS.md",
      "file": "ts/packages/hub/src/prompt.ts",
      "old": "const text = git([\"show\", \"HEAD:AGENTS.md\"], kernelRoot, false);",
      "new": "const text = readText(purePathStr(kernelRoot, \"AGENTS.md\"));"
