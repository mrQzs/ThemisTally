{
  "command": [
    "node",
    "node_modules/vitest/vitest.mjs",
    "run",
    "--bail",
    "1",
    "-t",
    "C0|C1|P0",
    "packages/contracts/test/readonly.contract.test.ts"
  ],
  "cwd": "ts",
  "timeout_seconds": 900,
  "mutations": [
    {
      "name": "K01 长度按 UTF-16 码元",
      "file": "ts/packages/dispatcher/src/logs-cat.ts",
      "old": "    this.length = text.length - this.astral.length;",
      "new": "    this.length = text.length;"
    },
    {
      "name": "K02 孤立代理项不写成转义",
      "file": "ts/packages/dispatcher/src/logs-cat.ts",
      "old": "  return dumps(value, { ensureAscii: false, indent }).replace(",
      "new": "  return dumps(value, { ensureAscii: false, indent }) || (\"\").replace("
