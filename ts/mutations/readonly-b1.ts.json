    {
      "name": "K03 json 模式不脱敏",
      "file": "ts/packages/dispatcher/src/logs-cat.ts",
      "old": "      return `${dumpJson(redactJson(loads(text)), 2)}\\n`;",
      "new": "      return `${dumpJson(loads(text), 2)}\\n`;"
    },
    {
      "name": "K04 json 解析不了就报错、不退回文本",
      "file": "ts/packages/dispatcher/src/logs-cat.ts",
      "old": "      if (!jsonOrRecursion(error)) throw error;",
      "new": "      throw error;"
    },
    {
