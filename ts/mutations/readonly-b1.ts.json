    {
      "name": "K18 --limit 不查下限",
      "file": "ts/packages/dispatcher/src/logs-cat.ts",
      "old": "  if (!(limit >= 1n && limit <= BigInt(SAFE_PAGE_CHARS))) {",
      "new": "  if (!(limit <= BigInt(SAFE_PAGE_CHARS))) {"
    },
    {
      "name": "K19 扩展名区分大小写",
      "file": "ts/packages/dispatcher/src/logs-cat.ts",
      "old": "  const lower = rel.toLowerCase();",
      "new": "  const lower = rel;"
