      "file": "ts/packages/dispatcher/src/logs-cat.ts",
      "old": "  if (!/^[0-9]+$/u.test(field)) throw new LogsError(BAD_CURSOR, LOGS_EXIT_USAGE);",
      "new": "  if (!/^[0-9a-f]+$/u.test(field)) throw new LogsError(BAD_CURSOR, LOGS_EXIT_USAGE);"
    },
    {
