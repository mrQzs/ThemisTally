{
  "command": [
    "node",
    "node_modules/vitest/vitest.mjs",
    "run",
    "packages/contracts/test/hub-contract-repo.contract.test.ts",
    "-t",
    "记到的顶层调用放回调用当时的快照",
    "--bail",
    "1"
  ],
  "cwd": "ts",
