    {
      "name": "P02 原因里不带过载的 provider_code",
      "file": "scripts/kit_hub.py",
      "old": "if details.get(\"provider_code\") in (QUIZS_OUTPUT_CUT, QUIZS_OVERLOADED):",
      "new": "if details.get(\"provider_code\") == QUIZS_OUTPUT_CUT:"
