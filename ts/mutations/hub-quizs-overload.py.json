{
  "command": [
    "python",
    "-m",
    "pytest",
    "tests/test_kit_hub.py",
    "-q",
    "-x",
    "-p",
    "no:cacheprovider",
    "-k",
    "quizs_overload or overloaded_interface or quizs_turn_reads or throttled_pi_turn"
  ],
  "cwd": ".",
  "timeout_seconds": 600,
  "mutations": [
    {
