    {
      "name": "P03 过载也照样累计限流次数",
      "file": "scripts/kit_hub.py",
      "old": "throttled = (not quizs_overloaded and spec[\"adapter\"] != \"claude\"",
      "new": "throttled = (spec[\"adapter\"] != \"claude\""
    },
    {
      "name": "P04 pi 的过载不再认",
      "file": "scripts/kit_hub.py",
      "old": "overloaded = quizs_overloaded or (loose and bool(OVERLOAD_RE.search(error)))",
      "new": "overloaded = quizs_overloaded"
    }
  ]
