      "file": "ts/packages/hub/src/land.ts",
      "old": "if (pyTruthy(pyGet(rehearsal, \"ok\")) && pyEq(pyGet(rehearsal, \"tree\"), landedTree)) {",
      "new": "if (pyTruthy(pyGet(rehearsal, \"ok\"))) {"
    },
    {
