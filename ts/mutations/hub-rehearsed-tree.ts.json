      "file": "ts/packages/hub/src/land.ts",
      "old": "  const landedTree = pyStrip(git([\"rev-parse\", \"HEAD^{tree}\"], hub.repo));\n  const [sha, recordProblem] = await commitRecords(hub, ts);",
      "new": "  const [sha, recordProblem] = await commitRecords(hub, ts);\n  const landedTree = pyStrip(git([\"rev-parse\", \"HEAD^{tree}\"], hub.repo));"
    },
    {
      "name": "S07 跳过时不记账",
      "file": "ts/packages/hub/src/land.ts",
      "old": "await hub.appendEvent(\"regression.skipped\",",
      "new": "await hub.appendEvent(\"regression.swept\","
    }
  ]
}
