{
  "command": [
    "python",
    "-m",
    "pytest",
    "tests/test_child_env_utf8.py",
    "-q",
    "-x",
    "-p",
    "no:cacheprovider"
  ],
  "cwd": ".",
  "timeout_seconds": 300,
  "mutations": [
    {
      "name": "P01 child_env 不补 PYTHONUTF8：检查日志里的中文断言又成了转义串",
      "file": "scripts/pi_dispatch.py",
      "old": "    env.setdefault(\"PYTHONUTF8\", \"1\")\n",
      "new": ""
    },
    {
      "name": "P02 外面显式设了 PYTHONUTF8 也被盖成 1",
      "file": "scripts/pi_dispatch.py",
      "old": "    env.setdefault(\"PYTHONUTF8\", \"1\")\n",
      "new": "    env[\"PYTHONUTF8\"] = \"1\"\n"
    }
  ]
}
