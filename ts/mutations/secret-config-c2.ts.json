{
  "command": [
    "node",
    "node_modules/vitest/vitest.mjs",
    "run",
    "packages/contracts/test/secret-config.contract.test.ts",
    "-t",
    "键名像凭据的普通值|collect --recover",
    "--bail",
    "1"
  ],
  "cwd": "ts",
  "timeout_seconds": 900,
  "mutations": [
    {
      "name": "S21 键名像凭据、值是普通文字不算",
      "file": "ts/packages/base/src/secrets.ts",
      "old": "      if (secretKey(pyStr(key)) && !emptyValue(item) && !secretNameField(sub, item) && !numberField(sub, item)) {",
      "new": "      if (false) {"
    },
    {
      "name": "S22 collect 读不了配置就当没有受保护路径",
      "file": "ts/packages/dispatcher/src/collect.ts",
      "old": "attemptProtectedPaths(repoConfig(repo), meta)",
      "new": "attemptProtectedPaths(new Map(), meta)"
    }
  ]
}
