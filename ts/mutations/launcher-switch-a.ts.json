{
  "command": [
    "python",
    "-m",
    "pytest",
    "-q",
    "-p",
    "no:cacheprovider",
    "-x",
    "tests/test_kernel_impl.py"
  ],
  "cwd": ".",
  "timeout_seconds": 600,
  "mutations": [
    {
      "name": "L01 名单少一条命令",
      "file": "scripts/pi_dispatch.py",
      "old": "    (\"cleanup\",): (\"repo\", \"run_dir\", \"force\"),\n",
      "new": ""
    },
    {
      "name": "L02 名单少一个键",
      "file": "scripts/pi_dispatch.py",
      "old": "\"keep_worktree\", \"keep_workspace\", \"while_running\"),",
      "new": "\"keep_worktree\", \"keep_workspace\"),"
    },
    {
      "name": "L03 不带 --assess 的 status 也转交",
      "file": "scripts/pi_dispatch.py",
      "old": "    if path == (\"status\",) and not args.assess:\n        return None\n",
      "new": ""
    },
    {
      "name": "L04 decisions replay 不分开",
      "file": "scripts/pi_dispatch.py",
      "old": "        path = (command, args.decisions_cmd)",
      "new": "        path = (command,)"
    },
    {
      "name": "L05 machine 取错",
      "file": "scripts/pi_dispatch.py",
      "old": "\"machine\": platform.machine()}",
      "new": "\"machine\": platform.node()}"
    },
    {
      "name": "L06 kernel_impl 不用交进来的",
      "file": "scripts/pi_dispatch.py",
      "old": "\"kernel_impl\": dict(impl)",
      "new": "\"kernel_impl\": read_kernel_impl()"
    },
    {
      "name": "L07 main 不转交调度器命令",
      "file": "scripts/pi_dispatch.py",
      "old": "        if impl[\"dispatcher\"] == \"ts\":\n            pyargs = dispatcher_handoff(args, impl)",
      "new": "        if False:\n            pyargs = dispatcher_handoff(args, impl)"
    },
    {
      "name": "L08 argv_impl 不认 status --assess",
      "file": "scripts/pi_dispatch.py",
      "old": "    assess = words[:1] == [\"status\"] and \"--assess\" in words",
      "new": "    assess = False"
    },
    {
      "name": "L09 argv_impl 不看选择文件",
      "file": "scripts/pi_dispatch.py",
      "old": "    if assess or (words[:1] != [\"status\"] and tuple(words[:1]) in TS_DISPATCHER_COMMANDS):\n        return \"ts\" if chosen[\"dispatcher\"] == \"ts\" else \"python\"",
      "new": "    if assess or (words[:1] != [\"status\"] and tuple(words[:1]) in TS_DISPATCHER_COMMANDS):\n        return \"ts\""
    },
    {
      "name": "L10 kit 根传错",
      "file": "scripts/pi_dispatch.py",
      "old": "{\"kit_root\": str(KIT_ROOT), \"kernel_impl\"",
      "new": "{\"kit_root\": str(KIT_ROOT.parent), \"kernel_impl\""
    }
  ]
}
