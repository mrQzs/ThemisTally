的解释器候选回退与字面参数保留。本函数的 doctor 检查（tests/test_dispatch.py:715-747）只在受控环境下运行：PATH 上没有真实 claude/codex，PI_CODING_AGENT_DIR 指向操作者记录的空目录；doctor 运行真实 CLI --version、读取真实 agent 目录的分支没有执行，这些 PASS 只代表该条件下的行为（L-CONTROLLED-PATHS）","reason":null,"source_location":"tests/test_dispatch.py:701","stdout_ref":{"bytes":13423,"original_sha256":"f40586e2376e2361bc962878059d732b95c2c8cb0f79d48c3fd069fc37e1080e","path":"docs/themis-tally-v2/01-baseline/evidence/bl-01t1-legacy-20260925/run/stdout.bin","redacted_changed":false,"sha256":"f40586e2376e2361bc962878059d732b95c2c8cb0f79d48c3fd069fc37e1080e"},"test_id":"tests/test_dispatch.py::test_setup_wrapper_doctor"},{"actual":{"checks":28,"failed":0,"passed":28,"stdout_lines":[125,153]},"argv":["python","tests/test_dispatch.py"],"baseline_ref":{"baseline_consistent":true,"capture_id":"bl-01t1-legacy-20260925","capture_json":{"bytes":36990,"original_sha256":"1089266169ff2af602c52990c404ac7ea84fc049d3257f6098d7e3dec25637d9","path":"docs/themis-tally-v2/01-baseline/evidence/bl-01t1-legacy-20260925/capture.json","redacted_changed":true,"sha256":"cf821420aa122ad6ea78cd823dfbfd712c402ad804dd82f174a68cd8334cec39"},"head":"a4fa199b0e5bdc658215765ee7558b9fe6723940","input_manifest_closure_sha256":"8ca10fb98b8d97213ae4430fdb3e8f444cb7aa0ac12fbdff8a5986513fece0a9","object_format":"sha1"},"check_id":"legacy-dispatch-full-suite/test_feedback_v11","column":"legacy_project","evidence_basis":"measured","evidence_refs":[{"bytes":13423,"original_sha256":"f40586e2376e2361bc962878059d732b95c2c8cb0f79d48c3fd069fc37e1080e","path":"docs/themis-tally-v2/01-baseline/evidence/bl-01t1-legacy-20260925/run/stdout.bin","redacted_changed":false,"sha256":"f40586e2376e2361bc962878059d732b95c2c8cb0f79d48c3fd069fc37e1080e"}],"execution_status":"PASS","expected":"该函数分节内的检查行全部为 PASS，没有 FAIL 行，没有异常记录","parent_check_id":"legacy-dispatch-full-suite","platform":"windows","reason":null,"source_location":"tests/test_dispatch.py:814","stdout_ref":{"bytes":13423,"original_sha256":"f40586e23