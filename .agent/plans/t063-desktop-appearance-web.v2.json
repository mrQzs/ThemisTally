  "definition_of_done": [
    {
      "id": "D01",
      "text": "主题与密度各只有一个写入口——`theme.ts` 的 `applyTheme`/`applyDensity` 写属性，标准密度去掉 `data-density`、紧凑写 `compact`，不碰类、内联样式、body 与存储",
      "evidence": [
        "V01",
        "V03"
      ],
      "intent": "密度这块「标准要去属性」的半边最容易漏，漏了就变成标准也带属性"
    },
    {
      "id": "D02",
      "text": "紧凑时数据表行高 40/44/52 变成 32/36/44，表头与没写 `data-row-height` 的表格不动，三条规则各带同行出处注释",
      "evidence": [
        "V01",
        "R01"
      ],
      "intent": "紧凑要真的把数据表压下去，且不误伤表头与别的表格"
    },
    {
      "id": "D03",
      "text": "外壳页能同步读外观、能订阅外观事件——十成员齐全且 `getAppearance` 是函数才调；缺成员/非函数/抛错/回值不是对象分别回 `null` 或空退订；十成员的旧假外壳仍被认作有外壳；退订真的能退",
      "evidence": [
        "V01"
      ],
      "intent": "别把「旧外壳」误判成「没有外壳」，也别在能力不存在时抛错"
    },
    {
      "id": "D04",
      "text": "服务窗口能同步读外观、能订阅外观事件、能保存主题——三个宿主函数在能力缺失时回 `null`/空退订/落到下一档；`saveTheme` 恰好调一次、只转交 `pref` 一个实参、信封原样",
      "evidence": [
        "V01",
        "R01"
      ],
      "intent": "服务窗口标题栏的菜单要真能存下主题"
    },
    {
      "id": "D05",
      "text": "页面用宿主给的外观起步、跟着外观事件变——初值宿主优先、其次桥、都没有暗+标准；事件逐字段校验（非法字段忽略）；桩模式下根元素不多属性、标题栏只改内存、不写存储",
      "evidence": [
        "V01",
        "R01"
      ],
      "intent": "外观要跨窗口一致，且开发与测试里的夹具模式行为一个字不变"
    },
    {
      "id": "D06",
      "text": "标题栏的主题菜单按三档保存——宿主保存 `ok:true` 才切、桥保存兑现后才切、都没有只切内存；保存失败保持原主题、不弹提示",
      "evidence": [
        "V01"
      ],
      "intent": "菜单点了要有效果，失败时不假装成功"
    },
    {
      "id": "D07",
      "text": "`themisShell.ts` 只补类型、`interface ThemisShell` 仍恰好十个成员、外壳侧一个字没改；类型检查与构建通过，外壳单测全过",
      "evidence": [
        "V02",
        "V04",
        "R01"
      ],
      "intent": "类型文件与外壳暴露面不能被这一片弄歪"
    },
    {
      "id": "D08",
      "text": "README 改掉「偏好只存内存」，写清外壳保存、启动同步读、改了广播、紧凑 40/44/52 各降 8，并保留「主题」「标题栏」两词",
      "evidence": [
        "R01",
        "review"
      ],
      "intent": "下一片照 README 就能对齐名字与字面量"
    },
    {
      "id": "D09",
      "text": "所有修改都在允许集合内；没有退役任何过渡断言、没有改任何既有测试文件与门禁文件",
      "evidence": [
        "scope",
