{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codekit:proposal:09:planning-bundle:1",
  "title": "Code-Kit 09 PlanningBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "request_id", "planner_request_ref", "mode", "graph_ref", "target_task_id", "investigation_baseline_ref", "requirement_refs", "facts", "assumptions", "questions", "risks", "task_graph", "contract_drafts", "budget_proposal", "stop_conditions"],
  "properties": {
    "record_type": {"const": "planning-bundle"},
    "schema_version": {"const": 1},
    "request_id": {"$ref": "#/$defs/Id"},
    "planner_request_ref": {"$ref": "#/$defs/ResourceRef"},
    "mode": {"enum": ["graph", "refine"]},
    "graph_ref": {"anyOf": [{"$ref": "#/$defs/ResourceRef"}, {"type": "null"}]},
    "target_task_id": {"anyOf": [{"$ref": "#/$defs/Id"}, {"type": "null"}]},
    "investigation_baseline_ref": {"$ref": "#/$defs/ResourceRef"},
    "requirement_refs": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/ResourceRef"}},
    "facts": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/Fact"}},
    "assumptions": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/Assumption"}},
    "questions": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/Question"}},
    "risks": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/Risk"}},
    "task_graph": {"$ref": "#/$defs/TaskGraph"},
    "contract_drafts": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/ContractDraft"}},
    "budget_proposal": {"$ref": "#/$defs/BudgetProposal"},
    "stop_conditions": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["budget_exhausted", "repair_limit", "no_baseline", "decision_required", "authorization_missing", "protocol_incomplete"]}}
  },
  "$defs": {
    "Id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "ResourceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "sha256", "path"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "Anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "start_byte", "end_byte", "quote_sha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/ResourceRef"},
        "start_byte": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "end_byte": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "quote_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "Fact": {
      "type": "object", "additionalProperties": false, "required": ["id", "text", "evidence_class", "evidence"],
      "properties": {"id": {"$ref": "#/$defs/Id"}, "text": {"type": "string", "minLength": 1, "maxLength": 16384}, "evidence_class": {"enum": ["source_observation", "runtime_observation"]}, "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/Anchor"}}}
    },
    "TaskIds": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}},
    "Assumption": {
      "type": "object", "additionalProperties": false, "required": ["id", "text", "task_ids", "state", "decision_ref"],
      "properties": {"id": {"$ref": "#/$defs/Id"}, "text": {"type": "string", "minLength": 1, "maxLength": 16384}, "task_ids": {"$ref": "#/$defs/TaskIds"}, "state": {"enum": ["unconfirmed", "confirmed", "rejected"]}, "decision_ref": {"anyOf": [{"$ref": "#/$defs/ResourceRef"}, {"type": "null"}]}}
    },
    "Question": {
      "type": "object", "additionalProperties": false, "required": ["id", "text", "task_ids", "blocks", "state", "decision_ref"],
      "properties": {"id": {"$ref": "#/$defs/Id"}, "text": {"type": "string", "minLength": 1, "maxLength": 16384}, "task_ids": {"$ref": "#/$defs/TaskIds"}, "blocks": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["graph_review", "refine", "publish"]}}, "state": {"enum": ["open", "resolved"]}, "decision_ref": {"anyOf": [{"$ref": "#/$defs/ResourceRef"}, {"type": "null"}]}}
    },
    "Risk": {
      "type": "object", "additionalProperties": false, "required": ["id", "description", "task_ids", "impact", "mitigation", "decision_ref"],
      "properties": {"id": {"$ref": "#/$defs/Id"}, "description": {"type": "string", "minLength": 1, "maxLength": 16384}, "task_ids": {"$ref": "#/$defs/TaskIds"}, "impact": {"enum": ["low", "medium", "high", "unknown"]}, "mitigation": {"type": "string", "minLength": 1, "maxLength": 16384}, "decision_ref": {"anyOf": [{"$ref": "#/$defs/ResourceRef"}, {"type": "null"}]}}
    },
    "Stage": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "depends_on", "plugin_step_ref"],
      "properties": {"id": {"$ref": "#/$defs/Id"}, "kind": {"enum": ["investigate", "change", "freeze", "check", "verdict"]}, "depends_on": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}}, "plugin_step_ref": {"anyOf": [{"$ref": "#/$defs/ResourceRef"}, {"type": "null"}]}}
    },
    "Task": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "depends_on", "requirement_ids", "scope_paths", "acceptance_intent", "stages", "estimated_calls"],
      "properties": {"id": {"$ref": "#/$defs/Id"}, "title": {"type": "string", "minLength": 1, "maxLength": 16384}, "depends_on": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}}, "requirement_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/Id"}}, "scope_paths": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}, "acceptance_intent": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 16384}}, "stages": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/Stage"}}, "estimated_calls": {"type": "integer", "minimum": 0, "maximum": 10000}}
    },
    "TaskGraph": {"type": "object", "additionalProperties": false, "required": ["tasks"], "properties": {"tasks": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/Task"}}}},
    "Baseline": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["state", "reason"], "properties": {"state": {"const": "unbound"}, "reason": {"type": "string", "minLength": 1, "maxLength": 16384}}}, {"type": "object", "additionalProperties": false, "required": ["state", "binding_ref"], "properties": {"state": {"const": "bound"}, "binding_ref": {"$ref": "#/$defs/ResourceRef"}}}]},
    "Narrative": {"type": "object", "additionalProperties": false, "required": ["goal", "non_goals", "behavior", "acceptance"], "properties": {"goal": {"type": "string", "minLength": 1, "maxLength": 16384}, "non_goals": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 16384}}, "behavior": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 16384}}, "acceptance": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 16384}}}},
    "ContractDraft": {
      "type": "object", "additionalProperties": false, "required": ["task_id", "completeness", "baseline", "scope_paths", "checks_ref", "executor_profile_ref", "environment_ref", "plugin_lock_ref", "narrative"],
      "properties": {"task_id": {"$ref": "#/$defs/Id"}, "completeness": {"enum": ["template", "complete"]}, "baseline": {"$ref": "#/$defs/Baseline"}, "scope_paths": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}, "checks_ref": {"anyOf": [{"$ref": "#/$defs/ResourceRef"}, {"type": "null"}]}, "executor_profile_ref": {"anyOf": [{"$ref": "#/$defs/ResourceRef"}, {"type": "null"}]}, "environment_ref": {"anyOf": [{"$ref": "#/$defs/ResourceRef"}, {"type": "null"}]}, "plugin_lock_ref": {"anyOf": [{"$ref": "#/$defs/ResourceRef"}, {"type": "null"}]}, "narrative": {"$ref": "#/$defs/Narrative"}}
    },
    "BudgetProposal": {"type": "object", "additionalProperties": false, "required": ["max_calls", "max_seconds", "max_repair_calls"], "properties": {"max_calls": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "max_seconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "max_repair_calls": {"type": "integer", "minimum": 0, "maximum": 100}}}
  }
}
