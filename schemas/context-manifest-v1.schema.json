{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codekit:proposal:09:context-manifest:1",
  "title": "Code-Kit 09 ContextManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "request_id", "resources"],
  "properties": {
    "record_type": {"const": "context-manifest"}, "schema_version": {"const": 1}, "request_id": {"$ref": "#/$defs/id"},
    "resources": {"type": "array", "minItems": 1, "maxItems": 512, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "baseline_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "requirements_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "environment_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "rules_refs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "decision_refs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "sha256", "path"], "properties": {
      "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "path": {"type": "string", "minLength": 1, "maxLength": 4096}
    }}
  }
}
