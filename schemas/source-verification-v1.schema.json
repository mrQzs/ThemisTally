{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codekit:source-verification:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "ref", "observed_sha256", "byte_length", "reason"],
  "properties": {
    "status": {"enum": ["verified", "missing", "incomplete", "hash_mismatch", "access_denied", "schema_unsupported", "conflict"]},
    "ref": {"$ref": "project-event-v1.schema.json#/$defs/ref"},
    "observed_sha256": {"anyOf": [{"$ref": "project-event-v1.schema.json#/$defs/sha"}, {"type": "null"}]},
    "byte_length": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
  }
}
