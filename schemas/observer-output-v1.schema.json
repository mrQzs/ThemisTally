{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codekit:observer-output:1",
  "type": "object", "additionalProperties": false,
  "required": ["record_type", "schema_version", "request_id", "source_cursor", "brief_ref", "facts", "hypotheses", "risks", "open_questions", "suggested_next_actions", "omitted"],
  "properties": {
    "record_type": {"const": "observer-output"}, "schema_version": {"const": 1}, "request_id": {"$ref": "#/$defs/id"}, "source_cursor": {"$ref": "#/$defs/cursor"}, "brief_ref": {"$ref": "#/$defs/ref"},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}, "maxItems": 256}, "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypothesis"}, "maxItems": 256}, "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}, "maxItems": 256}, "open_questions": {"type": "array", "items": {"$ref": "#/$defs/question"}, "maxItems": 256}, "suggested_next_actions": {"type": "array", "items": {"$ref": "#/$defs/action"}, "maxItems": 256},
    "omitted": {"type": "array", "items": {"$ref": "#/$defs/omitted"}, "maxItems": 256}, "status": {"enum": ["OK", "PARTIAL", "DEGRADED", "REJECTED"]}, "suggestions": {"type": "array", "items": {"$ref": "#/$defs/suggestion"}, "maxItems": 256}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "sha256", "path"], "properties": {"kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"}, "sha256": {"$ref": "#/$defs/sha"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$))(?!.*//)[^\\\n]+$"}}},
    "cursor": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}, "stream": {"type": "string", "minLength": 1, "maxLength": 128}, "generation": {"type": "integer", "minimum": 0}}},
    "base": {"type": "object", "additionalProperties": true, "required": ["id", "text", "source_refs"], "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1, "maxLength": 16384, "not": {"pattern": "(?i)\\b(pass(?:ed)?|approved?|authori[sz](?:e|ed|ation)|published?|released?)\\b"}}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}, "minItems": 1, "maxItems": 512, "uniqueItems": true}}},
    "fact": {"allOf": [{"$ref": "#/$defs/base"}], "unevaluatedProperties": false},
    "hypothesis": {"allOf": [{"$ref": "#/$defs/base"}], "type": "object", "required": ["id", "text", "source_refs", "missing_information", "verification_method"], "properties": {"missing_information": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "maxItems": 256}, "verification_method": {"type": "string", "minLength": 1, "maxLength": 16384}}, "unevaluatedProperties": false},
    "risk": {"allOf": [{"$ref": "#/$defs/base"}], "type": "object", "required": ["id", "text", "source_refs", "impact", "affected_task_ids"], "properties": {"impact": {"enum": ["low", "medium", "high", "unknown"]}, "affected_task_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 256, "uniqueItems": true}}, "unevaluatedProperties": false},
    "question": {"allOf": [{"$ref": "#/$defs/base"}], "type": "object", "required": ["id", "text", "source_refs", "affected_task_ids"], "properties": {"affected_task_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 256, "uniqueItems": true}}, "unevaluatedProperties": false},
    "action": {"allOf": [{"$ref": "#/$defs/base"}], "type": "object", "required": ["id", "text", "source_refs", "affected_task_ids", "requires_authorization"], "properties": {"affected_task_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 256, "uniqueItems": true}, "requires_authorization": {"type": "boolean"}}, "unevaluatedProperties": false},
    "omitted": {"type": "object", "additionalProperties": false, "required": ["id", "reason"], "properties": {"id": {"$ref": "#/$defs/id"}, "reason": {"type": "string", "minLength": 1, "maxLength": 16384}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}, "maxItems": 512, "uniqueItems": true}, "item_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 256, "uniqueItems": true}}},
    "suggestion": {"type": "object", "additionalProperties": false, "required": ["record_type", "schema_version", "suggestion_id", "request_id", "category", "text", "source_refs", "affected_task_ids", "requires_authorization"], "properties": {"record_type": {"const": "observer-suggestion"}, "schema_version": {"const": 1}, "suggestion_id": {"$ref": "#/$defs/id"}, "request_id": {"$ref": "#/$defs/id"}, "category": {"enum": ["hypothesis", "risk", "open_question", "suggested_next_action"]}, "text": {"type": "string", "minLength": 1, "maxLength": 16384}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}, "minItems": 1, "maxItems": 512}, "affected_task_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 256}, "requires_authorization": {"type": "boolean"}}}
  }
}
