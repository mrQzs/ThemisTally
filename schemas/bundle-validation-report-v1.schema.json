{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codekit:proposal:09:bundle-validation-report:1",
  "title": "Code-Kit 09 BundleValidationReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "valid", "semantic_support_verified", "errors"],
  "properties": {
    "record_type": {"const": "bundle-validation-report"},
    "schema_version": {"const": 1},
    "valid": {"type": "boolean"},
    "semantic_support_verified": {"type": "boolean"},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}}
  },
  "$defs": {
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "field", "reason"], "properties": {
      "code": {"type": "string", "minLength": 1}, "field": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "reason": {"type": "string", "minLength": 1}
    }}
  }
}
