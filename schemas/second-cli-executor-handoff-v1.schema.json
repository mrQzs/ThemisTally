{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codekit:second-cli-executor-handoff:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "request_id", "run_id", "operation_id", "executor_profile_id", "executor_session_id", "candidate_ref", "report_ref", "invocation_sha256", "result_sha256", "event_refs", "check_refs", "status", "settled", "budget_generation", "state", "execution_mode"],
  "$defs": {
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "path", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "properties": {
    "record_type": {"const": "executor-handoff"},
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "executor_profile_id": {"type": "string", "minLength": 1},
    "executor_session_id": {"type": "string", "minLength": 1},
    "candidate_ref": {"$ref": "#/$defs/resource_ref"},
    "report_ref": {"$ref": "#/$defs/resource_ref"},
    "invocation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/resource_ref"}},
    "check_refs": {"type": "array", "items": {"$ref": "#/$defs/resource_ref"}},
    "status": {"enum": ["SETTLED", "UNKNOWN", "BLOCKED", "START_UNKNOWN"]},
    "settled": {"type": "boolean"},
    "budget_generation": {"type": "integer", "minimum": 1},
    "state": {"enum": ["READY", "BLOCKED", "RECOVERY_REQUIRED"]},
    "execution_mode": {"enum": ["offline_stub", "deterministic_check"]}
  }
}
