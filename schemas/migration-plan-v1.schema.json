{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codekit/migration-plan-v1",
  "type": "object", "additionalProperties": false,
  "required": ["record_type", "schema_version", "migration_id", "repository_id", "request_id", "preflight_ref", "backup_ref", "maintenance_authorization_ref", "expected_generation", "before_selection_ref", "after_selection_ref", "operations", "state", "online_calls_allowed"],
  "properties": {
    "record_type": {"const": "migration-plan"}, "schema_version": {"const": 1},
    "migration_id": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"}, "request_id": {"$ref": "#/$defs/id"},
    "preflight_ref": {"$ref": "#/$defs/ref"}, "backup_ref": {"$ref": "#/$defs/ref"}, "maintenance_authorization_ref": {"$ref": "#/$defs/ref"},
    "expected_generation": {"type": "integer", "minimum": 1}, "before_selection_ref": {"$ref": "#/$defs/ref"}, "after_selection_ref": {"$ref": "#/$defs/ref"},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "state": {"enum": ["DISCOVERED", "PREFLIGHTED", "BACKUP_VERIFIED", "PLAN_REVIEWED", "DRAINING", "STAGED", "SWITCHED", "VERIFYING", "ACCEPTED", "HOLD", "FAILED", "ROLLING_BACK", "ROLLED_BACK"]},
    "online_calls_allowed": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$"}, "rid": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "sha256"], "properties": {"kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "id": {"$ref": "#/$defs/rid"}, "sha256": {"$ref": "#/$defs/sha"}, "path": {"type": "string", "minLength": 1}}},
    "operation": {"type": "object", "additionalProperties": false, "required": ["operation_id", "kind", "target_ref", "precondition_ref", "compensation_ref"], "properties": {"operation_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["stage_resource", "verify_resource", "switch_selection", "verify_history"]}, "target_ref": {"$ref": "#/$defs/ref"}, "precondition_ref": {"$ref": "#/$defs/ref"}, "compensation_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}}}
  }
}
