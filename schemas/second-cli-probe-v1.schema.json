{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codekit:second-cli-probe:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "adapter_id",
    "executable",
    "version_exit_code",
    "help_exit_code",
    "status",
    "capability",
    "version_sha256",
    "help_sha256"
  ],
  "properties": {
    "record_type": {"const": "second-cli-probe"},
    "schema_version": {"const": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "executable": {"type": "string", "minLength": 1},
    "version_exit_code": {"type": "integer"},
    "help_exit_code": {"type": "integer"},
    "status": {"enum": ["OBSERVED_EXECUTABLE", "BLOCKED"]},
    "capability": {"$ref": "#/$defs/capability"},
    "version_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "help_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "capability": {"type": "object", "additionalProperties": false, "required": ["record_type", "schema_version", "adapter_id", "protocol_version", "version", "platforms", "roles", "capabilities", "model_selection", "shell", "evidence", "offline", "environment_kinds"], "properties": {
      "record_type": {"const": "adapter-capability"},
      "schema_version": {"const": 1},
      "adapter_id": {"type": "string", "minLength": 1},
      "protocol_version": {"type": "string", "minLength": 1},
      "version": {"type": "string", "minLength": 1},
      "platforms": {"type": "array", "items": {"enum": ["linux", "macos", "windows"]}, "minItems": 1, "uniqueItems": true},
      "roles": {"type": "array", "items": {"enum": ["planner", "executor", "observer"]}, "minItems": 1, "uniqueItems": true},
      "capabilities": {"type": "array", "items": {"enum": ["streaming_events", "terminal_event", "model_identity", "tool_events", "usage", "read_only_mode"]}, "minItems": 1, "uniqueItems": true},
      "model_selection": {"enum": ["required", "optional", "unknown"]},
      "shell": {"type": "string", "minLength": 1},
      "offline": {"type": "boolean"},
      "environment_kinds": {"type": "array", "items": {"enum": ["native", "wsl"]}, "minItems": 1, "uniqueItems": true},
      "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["capability", "level", "source_ref", "note"], "properties": {"capability": {"type": "string"}, "level": {"enum": ["observed", "sample", "declared", "synthetic", "unknown"]}, "source_ref": {"anyOf": [{"$ref": "#/$defs/resource_ref"}, {"type": "null"}]}, "note": {"anyOf": [{"type": "string"}, {"type": "null"}]}}}}
    }},
    "resource_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "path", "sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
