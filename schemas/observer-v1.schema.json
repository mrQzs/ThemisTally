{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codekit:observer:1",
  "title": "Code-Kit optional observer offline protocol",
  "oneOf": [{"$ref":"#/$defs/Request"},{"$ref":"#/$defs/ObserverOutput"}],
  "$defs": {
    "Id": {"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},
    "Hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "Ref": {"type":"object","additionalProperties":false,"required":["kind","id","sha256","path"],"properties":{"kind":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"id":{"$ref":"#/$defs/Id"},"sha256":{"$ref":"#/$defs/Hash"},"path":{"type":"string","minLength":1,"maxLength":1024,"pattern":"^(?!/)(?!.*(?:^|/)[.][.](?:/|$)).+$"}}},
    "Cursor": {"type":"object","additionalProperties":false,"required":["start","end"],"properties":{"start":{"type":"integer","minimum":0},"end":{"type":"integer","minimum":0},"stream":{"type":"string","minLength":1},"generation":{"type":"integer","minimum":0}}},
    "Request": {"type":"object","additionalProperties":false,"required":["record_type","schema_version","request_id","source_cursor","brief_ref","source_refs","output_limits","profile_ref","environment_ref","timeout_seconds","max_retries","budget_reservation_ref"],"properties":{"record_type":{"const":"observer-request"},"schema_version":{"const":1},"request_id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/Id"},"source_cursor":{"$ref":"#/$defs/Cursor"},"brief_ref":{"$ref":"#/$defs/Ref"},"source_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"maxItems":512,"uniqueItems":true},"output_limits":{"type":"object","additionalProperties":false,"required":["max_bytes","max_items"],"properties":{"max_bytes":{"type":"integer","minimum":1},"max_items":{"type":"integer","minimum":1},"max_text":{"type":"integer","minimum":1}}},"profile_ref":{"anyOf":[{"$ref":"#/$defs/Ref"},{"type":"null"}]},"environment_ref":{"anyOf":[{"$ref":"#/$defs/Ref"},{"type":"null"}]},"timeout_seconds":{"type":"integer","minimum":1},"max_retries":{"type":"integer","minimum":0},"budget_reservation_ref":{"anyOf":[{"$ref":"#/$defs/Ref"},{"type":"null"}]},"trigger":{"enum":["threshold","stage_boundary","explicit_request","recovery"]},"observer_ref":{"$ref":"#/$defs/Id"}}},
    "Entry": {"type":"object","additionalProperties":false,"required":["id","text","source_refs"],"properties":{"id":{"$ref":"#/$defs/Id"},"text":{"type":"string","minLength":1,"maxLength":16384},"source_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"minItems":1,"maxItems":512,"uniqueItems":true},"affected_task_ids":{"type":"array","items":{"$ref":"#/$defs/Id"},"uniqueItems":true},"requires_authorization":{"type":"boolean"},"impact":{"enum":["low","medium","high","unknown"]},"missing_information":{"type":"array","items":{"type":"string","minLength":1},"minItems":1},"verification_method":{"type":"string","minLength":1}}},
    "Omitted": {"type":"object","additionalProperties":false,"required":["id","reason"],"properties":{"id":{"$ref":"#/$defs/Id"},"reason":{"type":"string","minLength":1},"source_refs":{"type":"array","items":{"$ref":"#/$defs/Ref"},"uniqueItems":true},"item_ids":{"type":"array","items":{"$ref":"#/$defs/Id"},"uniqueItems":true}}},
    "ObserverOutput": {"type":"object","additionalProperties":false,"required":["record_type","schema_version","request_id","source_cursor","brief_ref","facts","hypotheses","risks","open_questions","suggested_next_actions","omitted"],"properties":{"record_type":{"const":"observer-output"},"schema_version":{"const":1},"request_id":{"$ref":"#/$defs/Id"},"source_cursor":{"$ref":"#/$defs/Cursor"},"brief_ref":{"$ref":"#/$defs/Ref"},"facts":{"type":"array","items":{"$ref":"#/$defs/Entry"},"maxItems":256},"hypotheses":{"type":"array","items":{"$ref":"#/$defs/Entry"},"maxItems":256},"risks":{"type":"array","items":{"$ref":"#/$defs/Entry"},"maxItems":256},"open_questions":{"type":"array","items":{"$ref":"#/$defs/Entry"},"maxItems":256},"suggested_next_actions":{"type":"array","items":{"$ref":"#/$defs/Entry"},"maxItems":256},"omitted":{"type":"array","items":{"$ref":"#/$defs/Omitted"},"maxItems":256},"status":{"enum":["OK","PARTIAL","DEGRADED","REJECTED"]}}}
  }
}
