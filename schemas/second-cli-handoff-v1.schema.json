{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codekit:second-cli-handoff:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "request_id", "run_id", "planner_profile_id", "executor_profile_id", "planner_session_id", "executor_session_id", "contract_ref", "input_refs", "budget_generation", "read_only", "state"],
  "properties": {
    "record_type": {"const": "profile-handoff"},
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "planner_profile_id": {"type": "string", "minLength": 1},
    "executor_profile_id": {"type": "string", "minLength": 1},
    "planner_session_id": {"type": "string", "minLength": 1},
    "executor_session_id": {"type": "string", "minLength": 1},
    "contract_ref": {"$ref": "#/$defs/resource_ref"},
    "input_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/resource_ref"}},
    "budget_generation": {"type": "integer", "minimum": 1},
    "read_only": {"const": true},
    "state": {"enum": ["READY", "REQUIRES_REVIEW", "BLOCKED", "RECOVERY_REQUIRED"]}
  },
  "$defs": {
    "resource_ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "path", "sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
