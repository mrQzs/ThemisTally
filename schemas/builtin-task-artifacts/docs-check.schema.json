{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-kit.invalid/schemas/builtin-task-artifacts/docs-check.schema.json",
  "allOf": [
    {"$ref": "artifacts.schema.json"},
    {
      "properties": {
        "record_type": {"const": "docs-check"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "findings", "local_status", "unchecked", "semantic_review", "parser"],
          "properties": {
            "profile": {"const": "commonmark-explicit-anchors-v1"},
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "target", "status"],
                "properties": {
                  "source": {"type": "string"},
                  "target": {"type": "string"},
                  "status": {"type": "string"}
                }
              }
            },
            "local_status": {"enum": ["SATISFIED", "FAILED_OR_INCOMPLETE"]},
            "unchecked": {"type": "integer", "minimum": 0},
            "semantic_review": {"const": "NOT_PERFORMED"},
            "parser": {"type": "string"}
          }
        }
      }
    }
  ]
}
