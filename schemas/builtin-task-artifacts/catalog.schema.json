{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://code-kit.invalid/schemas/builtin-task-artifacts/catalog.schema.json",
  "type": "object", "additionalProperties": false, "required": ["record_type", "schema_version", "plugins"],
  "properties": {
    "record_type": {"const": "builtin-task-plugin-catalog"}, "schema_version": {"const": 1},
    "plugins": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["plugin_id", "version", "manifest_ref", "lock_ref"],
      "properties": {"plugin_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "manifest_ref": {"$ref": "#/$defs/ref"}, "lock_ref": {"$ref": "#/$defs/ref"}}}}
  },
  "$defs": {"ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "path", "sha256"],
    "properties": {"kind": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
