{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codekit:second-cli-planning-handoff:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "request_id", "run_id", "operation_id", "planner_profile_id", "planner_session_id", "planner_request_ref", "context_manifest_ref", "bundle_ref", "bundle_sha256", "budget_generation", "state", "execution_mode"],
  "$defs": {
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "path", "sha256"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "properties": {
    "record_type": {"const": "planning-handoff"},
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "planner_profile_id": {"type": "string", "minLength": 1},
    "planner_session_id": {"type": "string", "minLength": 1},
    "planner_request_ref": {"$ref": "#/$defs/resource_ref"},
    "context_manifest_ref": {"$ref": "#/$defs/resource_ref"},
    "bundle_ref": {"$ref": "#/$defs/resource_ref"},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "budget_generation": {"type": "integer", "minimum": 1},
    "state": {"enum": ["READY", "BLOCKED", "RECOVERY_REQUIRED"]},
    "execution_mode": {"enum": ["offline_stub", "deterministic_check"]}
  }
}
