{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codekit/migration-operation-v1",
  "type": "object", "additionalProperties": false,
  "required": ["operation_id", "kind", "target_ref", "precondition_ref", "compensation_ref"],
  "properties": {
    "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$"},
    "kind": {"enum": ["stage_resource", "verify_resource", "switch_selection", "verify_history"]},
    "target_ref": {"$ref": "#/$defs/ref"}, "precondition_ref": {"$ref": "#/$defs/ref"},
    "compensation_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
  },
  "$defs": {"ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "sha256"], "properties": {"kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "path": {"type": "string", "minLength": 1}}}}
}
