{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codekit/migration-records-v1",
  "oneOf": [
    {"$ref": "#/$defs/migration_preflight"},
    {"$ref": "#/$defs/migration_plan"},
    {"$ref": "#/$defs/migration_operation"},
    {"$ref": "#/$defs/migration_receipt"},
    {"$ref": "#/$defs/history_integrity_report"},
    {"$ref": "#/$defs/backup_snapshot"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$"},
    "rid": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "sha256"], "properties": {"kind": {"$ref": "#/$defs/kind"}, "id": {"$ref": "#/$defs/rid"}, "sha256": {"$ref": "#/$defs/sha"}, "path": {"type": "string", "minLength": 1}}},
    "preflight_check": {"type": "object", "additionalProperties": false, "required": ["check_id", "status", "source_ref", "remediation", "requires_write", "requires_network", "requires_cost"], "properties": {"check_id": {"$ref": "#/$defs/id"}, "status": {"enum": ["READY", "BLOCKED", "UNKNOWN", "NOT_APPLICABLE"]}, "source_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "remediation": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}, "requires_write": {"type": "boolean"}, "requires_network": {"type": "boolean"}, "requires_cost": {"type": "boolean"}}},
    "migration_preflight": {"type": "object", "additionalProperties": false, "required": ["record_type", "schema_version", "migration_id", "repository_id", "request_id", "checks", "status", "state", "offline_only"], "properties": {"record_type": {"const": "migration-preflight"}, "schema_version": {"const": 1}, "migration_id": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"}, "request_id": {"$ref": "#/$defs/id"}, "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/preflight_check"}}, "status": {"enum": ["READY", "BLOCKED", "UNKNOWN", "NOT_APPLICABLE"]}, "state": {"enum": ["DISCOVERED", "PREFLIGHTED", "HOLD", "FAILED"]}, "offline_only": {"const": true}}},
    "migration_operation": {"type": "object", "additionalProperties": false, "required": ["operation_id", "kind", "target_ref", "precondition_ref", "compensation_ref"], "properties": {"operation_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["stage_resource", "verify_resource", "switch_selection", "verify_history"]}, "target_ref": {"$ref": "#/$defs/ref"}, "precondition_ref": {"$ref": "#/$defs/ref"}, "compensation_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}}},
    "migration_plan": {"type": "object", "additionalProperties": false, "required": ["record_type", "schema_version", "migration_id", "repository_id", "request_id", "preflight_ref", "backup_ref", "maintenance_authorization_ref", "expected_generation", "before_selection_ref", "after_selection_ref", "operations", "state", "online_calls_allowed"], "properties": {"record_type": {"const": "migration-plan"}, "schema_version": {"const": 1}, "migration_id": {"$ref": "#/$defs/id"}, "repository_id": {"$ref": "#/$defs/id"}, "request_id": {"$ref": "#/$defs/id"}, "preflight_ref": {"$ref": "#/$defs/ref"}, "backup_ref": {"$ref": "#/$defs/ref"}, "maintenance_authorization_ref": {"$ref": "#/$defs/ref"}, "expected_generation": {"type": "integer", "minimum": 1}, "before_selection_ref": {"$ref": "#/$defs/ref"}, "after_selection_ref": {"$ref": "#/$defs/ref"}, "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/migration_operation"}}, "state": {"enum": ["DISCOVERED", "PREFLIGHTED", "BACKUP_VERIFIED", "PLAN_REVIEWED", "DRAINING", "STAGED", "SWITCHED", "VERIFYING", "ACCEPTED", "HOLD", "FAILED", "ROLLING_BACK", "ROLLED_BACK"]}, "online_calls_allowed": {"const": false}}},
    "migration_receipt": {"type": "object", "additionalProperties": false, "required": ["record_type", "schema_version", "migration_id", "operation_id", "idempotency_key", "plan_sha256", "from_generation", "to_generation", "before_selection_ref", "after_selection_ref", "status", "replayed", "currently_selected", "current_generation", "current_selection_ref"], "properties": {"record_type": {"const": "migration-receipt"}, "schema_version": {"const": 1}, "migration_id": {"$ref": "#/$defs/id"}, "operation_id": {"$ref": "#/$defs/id"}, "idempotency_key": {"$ref": "#/$defs/id"}, "plan_sha256": {"$ref": "#/$defs/sha"}, "from_generation": {"type": "integer", "minimum": 1}, "to_generation": {"type": "integer", "minimum": 1}, "before_selection_ref": {"$ref": "#/$defs/ref"}, "after_selection_ref": {"$ref": "#/$defs/ref"}, "status": {"enum": ["APPLIED", "REPLAYED", "ROLLED_BACK"]}, "replayed": {"type": "boolean"}, "currently_selected": {"type": "boolean"}, "current_generation": {"type": "integer", "minimum": 1}, "current_selection_ref": {"$ref": "#/$defs/ref"}}},
    "history_integrity_report": {"type": "object", "additionalProperties": false, "required": ["record_type", "schema_version", "status", "unchanged", "missing", "changed", "unplanned_added", "unreadable"], "properties": {"record_type": {"const": "history-integrity-report"}, "schema_version": {"const": 1}, "status": {"enum": ["PASS", "BLOCKED", "UNKNOWN"]}, "unchanged": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "missing": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "changed": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "unplanned_added": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "unreadable": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
    "backup_snapshot": {"type": "object", "additionalProperties": false, "required": ["record_type", "schema_version", "backup_id", "entries", "source_generation", "verified"], "properties": {"record_type": {"const": "backup-snapshot"}, "schema_version": {"const": 1}, "backup_id": {"$ref": "#/$defs/id"}, "entries": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}}}, "source_generation": {"type": "integer", "minimum": 1}, "verified": {"const": true}}}
  }
}
